# ---- OS / editor junk ----
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/

# ---- Python caches / virtual environments ----
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
.conda/

# ---- Credentials and keys (never commit) ----
.env*
*.pem
*.key
credentials/
*credentials*.json
*service-account*.json
id_rsa*
id_ed25519*

# ---- LaTeX intermediates ----
*.aux
*.log
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
# manuscript bibliographies are tracked (operator decision, W1); all other .bbl stay ignored
!papers/v*/main.bbl
*.blg

# ---- Model weights ----
*.safetensors
*.bin
*.pt
*.ckpt
*.gguf

# ---- Files over 50 MB (from W0 inventory) ----
# none found at W0 (largest file is 18.7 MB)

# ---- Local agent / tool state ----
.claude/
CLAUDE.md
.claude-bridge/
.remember/
# local research-vault index and config (binary SQLite index, rebuildable)
.hyperresearch/

# ---- Misc (pre-existing rule; directory is empty) ----
misc/

# ---- Wave 7 benchmark data cache (small benchmark files; tracked manifests list hashes) ----
docs/s7/parts/bench-A2/cache/

# ---- Wave 8 pipeline: run shards are git-ignored; manifests, configs, and the cost ledger are tracked ----
runs/*/**
!runs/*/MANIFEST.json
!runs/*/config/
!runs/*/config/*.json
# local model cache for the smoke test (one small ungated model) and pod-local caches
.hf-cache/
*.egg-info/
build/
analysis/results/
