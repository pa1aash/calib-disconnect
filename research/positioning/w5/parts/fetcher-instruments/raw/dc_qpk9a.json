"}],"affiliation":[]}],"dates":[{"date":"2026-03-11","dateType":"Created"},{"date":"2026-03-16","dateType":"Updated"},{"date":"2026-07-22","dateType":"Available"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Pre-registration","resourceTypeGeneral":"StudyRegistration"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"https://osf.io/np28j","relatedIdentifierType":"URL"}],"relatedItems":[{"titles":[{"title":"Signal Detection Theory for LLM Calibration"}],"creators":[],"publisher":"OSF","contributors":[],"relationType":"IsVersionOf","publicationYear":"2026","relatedItemType":"Text","relatedItemIdentifier":{"relatedItemIdentifier":"https://osf.io/np28j","relatedItemIdentifierType":"URL"}}],"sizes":[],"formats":[],"version":null,"rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"This project applies Signal Detection Theory (SDT; Green \u0026amp; Swets, 1966) to large language models as signal detectors on factual question-answering. Current LLM calibration metrics (ECE, Brier, semantic entropy) conflate two independent components: the model's ability to discriminate correct from incorrect answers (sensitivity, d′) and its willingness to commit to answers (response bias, c). SDT decomposes these, providing strictly more informative diagnostics. The central hypothesis is that temperature acts as a criterion shift in the moderate range (T ≤ 1.0), changing calibration without changing discriminability. The design uses a dual-paradigm approach: confidence-rating yes/no (primary) and 4-alternative forced choice (converging validation), with unequal-variance Gaussian SDT model fitting via MLE. Models: Llama-3-8B-Instruct, Mistral-7B-Instruct-v0.3, Llama-3-8B-base (exploratory). Datasets: TriviaQA (5,000 questions), Natural Questions (3,000 questions). All specifications are locked before data collection. All results reported regardless of outcome. Full methodological details in the attached documents.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://osf.io/qpk9a/","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":1,"viewsOverTime":[{"yearMonth":"2026-08","total":1}],"downloadCount":0,"downloadsOverTime":[{"yearMonth":"2026-08","total":0}],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-07-22T05:01:45.000Z","registered":"2026-07-22T05:01:46.000Z","published":"2026","updated":"2026-07-22T05:01:50.000Z"},"relationships":{"client":{"data":{"id":"cos.osf","type":"clients"}},"provider":{"data":{"id":"cos","type":"providers"}},"media":{"data":{"id":"10.17605/osf.io/qpk9a","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}