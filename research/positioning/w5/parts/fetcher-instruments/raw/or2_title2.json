pen-Code"},"authors":{"value":["Madiha Zahrah Choksi","Ilan Mandel","David Gray Widder","Yan Shvartzshnaider"]}},"tmdate":1747316007137,"pdate":1704067200000,"tcdate":1747316001594,"writers":["~"],"signatures":["~Yan_Shvartzshnaider1"],"forum":"HSGWzZY8se","license":"CC BY-SA 4.0","number":488393,"cdate":1704067200000,"readers":["everyone"],"invitations":["DBLP.org/-/Record","DBLP.org/-/Edit"],"mdate":1747316007137,"domain":"DBLP.org","id":"HSGWzZY8se","version":2}],"count":10000}