{
  "name": "pilot-mixed-only",
  "description": "Pilot part 2 only: P1 to P6 label-validity generation at k = 10 and execution labels under both suites. No forward pass, capture, readout, or score.",
  "launchable": true,
  "pod": true,
  "config": {
    "models": [
      "P1",
      "P2",
      "P3",
      "P4",
      "P5",
      "P6"
    ],
    "benchmarks": [
      "humaneval_plus",
      "mbpp_plus"
    ],
    "k": 10,
    "fold_seeds": [
      0
    ],
    "backend": "vllm",
    "device": "cuda",
    "sandbox": "bwrap",
    "execute_untrusted": true,
    "stages": [
      "data",
      "generate",
      "execute"
    ],
    "generation_only_models": [
      "P1",
      "P2",
      "P3",
      "P4",
      "P5",
      "P6"
    ],
    "seal_gamma": true
  },
  "groups": [
    {
      "stages": [
        "data"
      ],
      "scopes": [
        "label_validity"
      ]
    },
    {
      "stages": [
        "generate",
        "execute"
      ],
      "models": [
        "P1",
        "P2",
        "P3",
        "P4",
        "P5",
        "P6"
      ],
      "scopes": [
        "humaneval_plus",
        "mbpp_plus"
      ]
    }
  ]
}
