#!/usr/bin/env bash
# Repository hygiene checks run before every commit.
set -euo pipefail

EXPECTED_NAME="Palaash Gang"
EXPECTED_EMAIL="palaashgang@gmail.com"
fail=0

# 1. Author and committer identity must be exactly the expected one.
for v in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  ident="$(git var "$v" | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')"
  if [ "$ident" != "$EXPECTED_NAME <$EXPECTED_EMAIL>" ]; then
    echo "pre-commit: $v is '$ident', expected '$EXPECTED_NAME <$EXPECTED_EMAIL>'." >&2
    fail=1
  fi
done

# 2. No staged paths under the local agent directory or named after its instruction file.
bad_paths="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.cl[a]ude/|(^|/)CL[A]UDE\.md$' || true)"
if [ -n "$bad_paths" ]; then
  echo "pre-commit: forbidden staged paths:" >&2
  printf '  %s\n' $bad_paths >&2
  fail=1
fi

# 3. No staged content with attribution strings (added lines only).
#    The 'generated' phrase is matched case-sensitively (capitalised form); the others case-insensitively.
added="$(git diff --cached --no-color -U0 --diff-filter=ACMR | grep -E '^\+' | grep -vE '^\+\+\+ ' || true)"
hits_ci="$(printf '%s\n' "$added" | grep -ciE 'co-authored[-]by|noreply[@]anthrop[i]c\.com|cl[a]ude\.ai/code' || true)"
hits_cs="$(printf '%s\n' "$added" | grep -cE 'Generated[ ]with' || true)"
if [ "${hits_ci:-0}" -gt 0 ] || [ "${hits_cs:-0}" -gt 0 ]; then
  echo "pre-commit: staged content contains forbidden attribution strings ($((hits_ci + hits_cs)) line(s))." >&2
  git diff --cached --name-only --diff-filter=ACMR -z | while IFS= read -r -d '' f; do
    if git show ":$f" 2>/dev/null | grep -qiE 'co-authored[-]by|noreply[@]anthrop[i]c\.com|cl[a]ude\.ai/code' \
       || git show ":$f" 2>/dev/null | grep -qE 'Generated[ ]with'; then
      echo "  $f" >&2
    fi
  done
  fail=1
fi

# 5. Legacy freeze (docs/LEGACY.md): reject any staged addition, modification, deletion, rename
#    or type change that touches a frozen path. There is deliberately no override switch; a change
#    to the freeze must edit this pattern in its own commit.
FROZEN_RE='^(papers/v[123]/|src/(v1_baseline|v2_comprehensive|v3_multimodel|v4_dprc)/|results/|data/|archives/[^/]*\.zip$|REPRODUCE\.md$)'
frozen_hits="$(git diff --cached --name-only --no-renames | grep -E "$FROZEN_RE" || true)"
if [ -n "$frozen_hits" ]; then
  echo "pre-commit: staged changes touch frozen legacy paths (see docs/LEGACY.md):" >&2
  printf '%s\n' "$frozen_hits" | sed 's/^/  /' >&2
  fail=1
fi

# 6. Frozen design (wave 7): docs/s7/PIPELINE_DESIGN_FROZEN.md and its hash file may be added once
#    and never modified, deleted, or renamed afterward. When added, the recorded SHA-256 must match.
#    Deviations go to docs/DEVIATIONS.md. There is deliberately no override switch.
FROZEN_DESIGN="docs/s7/PIPELINE_DESIGN_FROZEN.md"
FROZEN_HASH="docs/s7/FROZEN_SHA256.txt"
design_changes="$(git diff --cached --name-status --no-renames | awk -v a="$FROZEN_DESIGN" -v b="$FROZEN_HASH" '$2==a || $2==b {print $1" "$2}')"
if [ -n "$design_changes" ]; then
  while read -r st path; do
    if [ "$st" != "A" ] || git cat-file -e "HEAD:$path" 2>/dev/null; then
      echo "pre-commit: $path is frozen; record changes in docs/DEVIATIONS.md instead ($st)." >&2
      fail=1
    fi
  done <<< "$design_changes"
  if git cat-file -e ":$FROZEN_DESIGN" 2>/dev/null && git cat-file -e ":$FROZEN_HASH" 2>/dev/null; then
    want="$(git show ":$FROZEN_HASH" | grep -oE '[0-9a-f]{64}' | head -1)"
    have="$(git show ":$FROZEN_DESIGN" | shasum -a 256 | cut -d' ' -f1)"
    if [ "$want" != "$have" ]; then
      echo "pre-commit: $FROZEN_HASH does not match the SHA-256 of $FROZEN_DESIGN." >&2
      fail=1
    fi
  fi
fi

# 7. Pre-pilot analysis-code hash (wave 8, design section 13). The analysis/ tree was hashed before the
#    pilot (docs/DEVIATIONS.md, DEV-015). Later changes are allowed but each must cite a DEVIATIONS
#    entry. This check only WARNS; it never blocks. Generated outputs under analysis/results/ are exempt.
analysis_changes="$(git diff --cached --name-only | grep -E '^analysis/' | grep -vE '^analysis/results/' || true)"
if [ -n "$analysis_changes" ]; then
  echo "pre-commit: WARNING: this commit changes analysis/ code after the pre-pilot hash (DEV-015):" >&2
  printf '  %s\n' $analysis_changes >&2
  if git diff --cached --name-only | grep -qx 'docs/DEVIATIONS.md'; then
    echo "pre-commit: WARNING: make sure the new docs/DEVIATIONS.md entry cites this change." >&2
  else
    echo "pre-commit: WARNING: docs/DEVIATIONS.md is not staged; add an entry citing this change." >&2
  fi
fi

# 4. Secret scan of staged changes.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found on PATH; install it (brew install gitleaks)." >&2
  fail=1
elif ! gitleaks git --pre-commit --staged --redact --no-banner --log-level warn; then
  echo "pre-commit: gitleaks reported findings in staged changes." >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: commit rejected." >&2
  exit 1
fi
exit 0
